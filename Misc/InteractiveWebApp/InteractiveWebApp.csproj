<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Accelerator fails to run the Razor source generator on .NET 10 (Microsoft.Extensions.ObjectPool load error). -->
    <ILNAcceleratorEnabled>false</ILNAcceleratorEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Pages\_ViewStart1.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILNumerics.Computing" Version="*" />
    <PackageReference Include="ILNumerics.Drawing" Version="*" />
    <PackageReference Include="ILNumerics.numpy" Version="*" />
  </ItemGroup>

</Project>
