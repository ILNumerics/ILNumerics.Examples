<Project Sdk="Microsoft.NET.Sdk">

  <!-- Startup hook injected into every windowed example by the smoke runner (DOTNET_STARTUP_HOOKS).
       It needs no changes to the examples: it turns unhandled UI exceptions into crashes, waits for the
       main window, saves a screenshot plus an offscreen software (GDI) rendering of the ILNumerics scene,
       and then closes the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: at runtime the hook binds to the ILNumerics assemblies shipped with the example. -->
    <PackageReference Include="ILNumerics.Drawing.Platforms" Version="*" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
