<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- ILNumerics Accelerator generates invalid namespaces for assembly names starting with a digit. -->
    <AssemblyName>Example_3DBarGraph</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILNumerics.Drawing.Platforms" Version="*" />
    <PackageReference Include="ILNumerics.Toolboxes.Drawing2" Version="*" />
  </ItemGroup>

</Project>