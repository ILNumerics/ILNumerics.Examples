<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Workaround: with the Accelerator, the first construction of a segment from many TPL threads
         at once races in ILNumerics.Licensing.RuntimeLicenseProvider.GetLicense (a non-concurrent
         Dictionary). Re-enable once that is fixed. -->
    <ILNAcceleratorEnabled>false</ILNAcceleratorEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ILNumerics.Computing" Version="*" />
  </ItemGroup>

</Project>